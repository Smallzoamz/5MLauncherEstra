{
  "name": "estra-fivem-launcher",
  "private": true,
  "version": "2.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/server/start.js",
    "social-server": "node src/server/socialServer.js",
    "test": "node --test tests/*.test.js",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:ui": "node tests/ui-audit.cjs && node tests/ui-success.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop": "tauri dev",
    "dist:win": "tauri build",
    "electron:desktop": "npm run build && electron .",
    "electron:dist:win": "npm run build && node scripts/write-notices.mjs && electron-builder --win nsis --x64",
    "pack:win": "npm run build && node scripts/write-notices.mjs && electron-builder --win --dir --x64",
    "test:desktop": "node tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "classic-level": "3.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "description": "Estra FiveM Launcher for Windows",
  "author": "Estra FiveM Launcher contributors",
  "productName": "Estra FiveM Launcher"
}
