{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estra FiveM Launcher",
  "version": "2.1.0",
  "identifier": "local.fivemlauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Estra FiveM Launcher",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0b0c0e",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: http:; connect-src 'self' ipc: http://ipc.localhost https://hcynletyqztbbouwlcsg.supabase.co wss://hcynletyqztbbouwlcsg.supabase.co; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Thai"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOEM3RDgyMDRGODNGRjAKUldUd1AvZ0VnbjJNMmtPOW92SkFWbUtGaWNzazJ3V2hZU21QeDFDU2t2bkEvdUcwTEhPY0Y0R1MK",
      "endpoints": [
        "https://github.com/Smallzoamz/5MLauncherEstra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
